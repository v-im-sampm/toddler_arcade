  "tests": {
    "seed": 12648430,
    "replays": [
      { "file": "tests/replays/touch_only_10_rounds.replay", "covers": ["CP-1", "CP-2", "CP-5"], "device_bench": true },
      { "file": "tests/replays/wrong_then_hint_then_autohelp.replay", "covers": ["CP-3"] },
      { "file": "tests/replays/voice_answers.replay", "covers": ["CP-4"] },
      { "file": "tests/replays/audio_off.replay", "covers": ["CP-6"] },
      { "file": "tests/replays/mash_and_home_mid_celebrate.replay", "covers": ["CP-7", "CP-8"] }
    ]
  }
