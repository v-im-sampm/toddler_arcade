{
  "$comment": "Little Arcade v2 design tokens. Single source of truth; generate per-platform constants (C/C++/Rust/TS/CSS) from this file and check for drift in CI. Values are starting points — tune on the real panel and speaker, record changes in a design ADR.",
  "version": 1,
  "stage": {
    "width": 320,
    "height": 240,
    "aspect": "4:3",
    "chrome": {
      "home": { "x": 0, "y": 0, "w": 56, "h": 56 },
      "mic": { "x": 264, "y": 0, "w": 56, "h": 56 },
      "play_area_top": 64
    },
    "target": { "min": 48, "preferred": 56, "spacing_min": 8, "hit_slop_max": 6 },
    "density_exports": [1, 2, 3]
  },
  "color": {
    "$comment": "Each hue has shadow/base/light. Answer hues are tuned for CVD separation and MUST be paired with patterns.",
    "hue": {
      "red":     { "shadow": "#B8323A", "base": "#EF4B4F", "light": "#FF9A92" },
      "orange":  { "shadow": "#C2621B", "base": "#FF8A2A", "light": "#FFC07F" },
      "yellow":  { "shadow": "#C99A0E", "base": "#FFD23F", "light": "#FFEB9C" },
      "lime":    { "shadow": "#6E9A1F", "base": "#A6D13B", "light": "#D6EE95" },
      "green":   { "shadow": "#1E8452", "base": "#2DB26E", "light": "#8EE0B4" },
      "teal":    { "shadow": "#127A7D", "base": "#21B3B0", "light": "#8FE3DE" },
      "sky":     { "shadow": "#2B79B8", "base": "#4FB0F0", "light": "#A9DBFB" },
      "blue":    { "shadow": "#2448A8", "base": "#3A6FE8", "light": "#9DB8FA" },
      "purple":  { "shadow": "#6236A6", "base": "#8F5BE0", "light": "#C9AEF5" },
      "pink":    { "shadow": "#B23E86", "base": "#F06BB8", "light": "#FBB6DC" },
      "brown":   { "shadow": "#7A4E2D", "base": "#B07A4F", "light": "#DDB892" },
      "cream":   { "shadow": "#D9C7A3", "base": "#FFF3D6", "light": "#FFFBEF" }
    },
    "neutral": {
      "ink": "#3B3550",
      "ink_soft": "#6F6888",
      "paper": "#FFF8EC",
      "night": "#1E2245",
      "shade_alpha": 0.35
    },
    "role": {
      "sky_day": "#BFE6FF",
      "sky_dusk": "#F8C9A8",
      "sky_night": "#2A2F66",
      "ground": "#A6D13B",
      "water": "#4FB0F0",
      "interactive_highlight": "#FFFFFF",
      "hint_glow": "#FFE066",
      "touch_ripple": "#FFFFFF",
      "outline_lightness_factor": 0.55,
      "background_max_lstar": 92
    },
    "answer_set": {
      "$comment": "v1 parity: colour + pattern so colour is never the only cue.",
      "RED":    { "hue": "red",    "pattern": "heart" },
      "BLUE":   { "hue": "blue",   "pattern": "wave" },
      "GREEN":  { "hue": "green",  "pattern": "leaf" },
      "YELLOW": { "hue": "yellow", "pattern": "star" }
    }
  },
  "motion": {
    "dur_ms": {
      "instant": 60,
      "quick": 140,
      "base": 220,
      "gentle": 400,
      "scene": 450,
      "celebrate_small": 1200,
      "celebrate": 1500,
      "celebrate_big": 2000,
      "max_input_block": 300
    },
    "ease": {
      "out":    [0.22, 1.0, 0.36, 1.0],
      "in":     [0.64, 0.0, 0.78, 0.0],
      "inOut":  [0.65, 0.0, 0.35, 1.0],
      "backOut":[0.34, 1.56, 0.64, 1.0]
    },
    "spring": {
      "bouncy": { "stiffness": 380, "damping": 14, "mass": 1 },
      "soft":   { "stiffness": 160, "damping": 18, "mass": 1 }
    },
    "squash": {
      "press": [1.12, 0.88],
      "land":  [[1.18, 0.82], [0.94, 1.06], [1.0, 1.0]]
    },
    "idle": {
      "breath_period_ms": [2400, 3200],
      "breath_scale": 0.025,
      "blink_interval_ms": [2000, 6000],
      "bob_units": 2
    },
    "hint": {
      "wiggle_deg": 6,
      "wiggle_cycles": 3,
      "wiggle_ms": 360,
      "glow_period_ms": 900,
      "auto_help_after_misses": 2,
      "idle_visual_hint_ms": 6000,
      "idle_spoken_hint_ms": 12000
    },
    "safety": {
      "max_flashes_per_s": 3,
      "max_shake_units": 2,
      "max_shake_ms": 300,
      "max_spin_rev_per_s": 1,
      "reduced_motion_particle_scale": 0.5,
      "reduced_motion_parallax_scale": 0.5
    }
  },
  "particles": {
    "device_max_live": 96,
    "device_max_per_emitter": 48,
    "web_max_live": 400,
    "presets": {
      "sparkle_burst": { "count": 16, "life_ms": [350, 700], "speed": [40, 110], "gravity": 60, "shape": "star", "ramp": ["yellow.light", "cream.light"], "additive": true },
      "confetti":      { "count": 36, "life_ms": [900, 1500], "speed": [60, 160], "gravity": 140, "shape": "rect", "ramp": ["red.base", "yellow.base", "green.base", "blue.base", "pink.base"], "additive": false },
      "bubbles":       { "count": 10, "life_ms": [1200, 2400], "speed": [15, 35], "gravity": -30, "shape": "ring", "ramp": ["sky.light"], "additive": false },
      "notes":         { "count": 6,  "life_ms": [800, 1200], "speed": [20, 50], "gravity": -20, "shape": "note", "ramp": ["purple.base", "pink.base"], "additive": false }
    }
  },
  "audio": {
    "device_sample_rate_hz": "TBD (ADR-012; v1 = 16000)",
    "web_sample_rate_hz": 48000,
    "speech_sample_rate_hz": 16000,
    "default_scale": "major_pentatonic",
    "min_attack_ms": 3,
    "min_release_ms": 10,
    "retrigger_merge_ms": 40,
    "max_onset_jump_db": 12,
    "volume": { "levels": 7, "step_db": 4, "default_device": 0, "ramp_ms": 300 },
    "bus_targets": {
      "voice_lufs_i": -18,
      "music_lufs_i": -24,
      "ambience_lufs_i": -30,
      "sfx_peak_dbfs": -9,
      "sampler_peak_dbfs": -6
    },
    "duck": { "voice_over_music_db": -8, "attack_ms": 60, "release_ms": 300 },
    "length_ms": { "tap_max": 150, "success_max": 600, "sting_max": 2000, "prompt_max": 2000 }
  },
  "input": {
    "tap_debounce_ms": 80,
    "hold_ms": 350,
    "drag_dead_zone": 12,
    "voice_dedupe_ms": 750,
    "voice_listen_silence_ms": 4000,
    "voice_listen_max_ms": 8000,
    "parent_gate_hold_ms": 5000
  },
  "shell": {
    "sleep_after_ms": 600000,
    "session_timer_options_min": [0, 10, 20, 30],
    "transition": "bubble_iris"
  }
}
