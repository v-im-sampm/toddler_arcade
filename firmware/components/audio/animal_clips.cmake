# Turns the committed 16 kHz mono 16-bit animal-call WAVs into a C++ table of
# flash-resident PcmClips. Runs at configure time in plain CMake so the host,
# simulator and ESP-IDF builds need no extra tools. The WAVs are produced by
# tools/make_animal_clips.py (canonical 44-byte header, no extra chunks).

function(la_generate_animal_clips wav_dir out_cpp)
  set(names cow duck sheep pig dog cat frog owl)
  set(arrays "")
  set(table "")
  foreach(name IN LISTS names)
    set(wav "${wav_dir}/${name}.wav")
    if(NOT EXISTS "${wav}")
      message(FATAL_ERROR "Missing animal call ${wav}; run tools/make_animal_clips.py")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${wav}")

    file(READ "${wav}" header LIMIT 44 HEX)
    string(SUBSTRING "${header}" 0 8 riff)
    string(SUBSTRING "${header}" 16 8 wave)
    string(SUBSTRING "${header}" 40 32 fmt)  # format, channels, rate, byte rate, align, bits
    string(SUBSTRING "${header}" 72 8 data)
    if(NOT riff STREQUAL "52494646" OR NOT wave STREQUAL "57415645" OR NOT data STREQUAL "64617461"
       OR NOT fmt STREQUAL "01000100803e0000007d000002001000")
      message(FATAL_ERROR "${wav} must be a canonical 16 kHz mono 16-bit PCM WAV")
    endif()

    file(READ "${wav}" pcm OFFSET 44 HEX)
    string(LENGTH "${pcm}" hex_len)
    math(EXPR samples "${hex_len} / 4")
    if(samples EQUAL 0)
      message(FATAL_ERROR "${wav} has no samples")
    endif()
    # Little-endian byte pairs -> 16-bit words, 8 per line (CMake regex has no {n}).
    string(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])" "0x\\2\\1," words "${pcm}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f][0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f][0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f][0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f][0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f][0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f][0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f][0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f][0-9a-f][0-9a-f],))" "\\1\n    " words "${words}")

    string(APPEND arrays "// ${name}.wav: ${samples} samples\nalignas(4) const uint16_t k_${name}[] = {\n    ${words}\n};\n\n")
    string(APPEND table "    {reinterpret_cast<const int16_t*>(k_${name}), ${samples}u},\n")
  endforeach()

  set(text "// Generated by firmware/components/audio/animal_clips.cmake from\n")
  string(APPEND text "// assets/audio/animal_sounds/*.wav. Do not edit.\n")
  string(APPEND text "#include \"little_arcade/audio/animal_clips.hpp\"\n\n")
  string(APPEND text "namespace little_arcade::audio {\nnamespace {\n\n")
  string(APPEND text "${arrays}")
  string(APPEND text "// int16 may alias its unsigned counterpart, so the cast is well defined.\n")
  string(APPEND text "const PcmClip kClips[kAnimalClipCount] = {\n${table}};\n\n}  // namespace\n\n")
  string(APPEND text "const PcmClip& animal_clip(uint8_t animal) { return kClips[animal % kAnimalClipCount]; }\n\n")
  string(APPEND text "}  // namespace little_arcade::audio\n")

  file(WRITE "${out_cpp}.tmp" "${text}")
  configure_file("${out_cpp}.tmp" "${out_cpp}" COPYONLY)
endfunction()
